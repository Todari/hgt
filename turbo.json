{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_SSL",
    "PORT",
    "CORS_ORIGINS",
    "DEMO_ACCOUNTS",
    "HONGIK_ALLOWED_STATUSES",
    "ADMIN_TOKEN",
    "MATCH_CRON_ENABLED",
    "MATCH_INACTIVE_DAYS",
    "FIREBASE_SERVICE_ACCOUNT",
    "SENTRY_DSN",
    "SENTRY_ENVIRONMENT",
    "NODE_ENV",
    "NEXT_PUBLIC_API_URL",
    "BUILD_TARGET"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^check-types"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "prepare": {
      "dependsOn": [
        "^prepare"
      ],
      "outputs": [
        "styled-system/**"
      ]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    }
  }
}
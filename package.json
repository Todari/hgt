{
  "name": "hgt",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "check-types": "turbo check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:push": "pnpm --filter api db:push",
    "db:generate": "pnpm --filter api db:generate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:studio": "pnpm --filter api db:studio"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "turbo": "^2.10.8",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "version": "1.0.0",
  "description": "HGT — Hongik University keyword-matching dating service (Turborepo monorepo)",
  "dependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-turbo": "^2.10.8",
    "eslint-scope": "^8.4.0",
    "eslint-visitor-keys": "^4.2.1",
    "typescript-eslint": "^8.65.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Todari/hgt.git"
  },
  "keywords": [
    "hgt",
    "nextjs",
    "hono",
    "postgresql",
    "capacitor",
    "turborepo"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Todari/hgt/issues"
  },
  "homepage": "https://hgt.todari.dev",

# Copy to apps/api/.env (gitignored) and adjust.

# --- Local development (docker-compose postgres; host port 5433) ---
DATABASE_URL=postgresql://hgt:hgt_local_dev@localhost:5433/hgt
DATABASE_SSL=false

# --- Production (AWS RDS) example ---
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>.rds.amazonaws.com:5432/hgt
# DATABASE_SSL=true

PORT=8080
# Comma-separated list of allowed browser origins (the Next.js apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Hongik 재학생 게이팅: 허용할 학적상태 (쉼표 구분). 기본 재학,휴학 (졸업 차단).
HONGIK_ALLOWED_STATUSES=재학,휴학

# Admin token for POST /admin/match/run (locked/403 if unset). The weekly cron sends it.
# ADMIN_TOKEN=change-me

# Enable in-process weekly matching. Set to "true" on exactly ONE instance.
# MATCH_CRON_ENABLED=true

# Firebase service-account JSON (one line) to enable push via FCM.
# Until set, sendPush() logs a no-op (app still works).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

# Copy to apps/api/.env (gitignored) and adjust.

# --- Local development (docker-compose postgres; host port 5433) ---
DATABASE_URL=postgresql://hgt:hgt_local_dev@localhost:5433/hgt
DATABASE_SSL=false

# --- Production (AWS RDS) example ---
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>.rds.amazonaws.com:5432/hgt
# DATABASE_SSL=true

PORT=8080
# Comma-separated list of allowed browser origins (the Next.js apps).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

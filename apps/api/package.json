    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@hgt-client/eslint-config": "workspace:*",
    "@hgt-client/typescript-config": "workspace:*",
    "@types/node": "^20.11.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "5.5.4"
  }

# apps/api — PRODUCTION env (EC2). Copy to apps/api/.env on the server. Never commit.

# --- Database: local Postgres on the EC2 (docker compose up -d postgres) ---
DATABASE_URL=postgresql://hgt:hgt_local_dev@localhost:5433/hgt
DATABASE_SSL=false

# --- Server ---
PORT=8080
# Vercel web origin(s), comma-separated. The native app uses capacitor:// (auto-allowed).
CORS_ORIGINS=https://<your-app>.vercel.app

# --- Hongik 재학생 게이팅 (운영은 졸업 제외) ---
HONGIK_ALLOWED_STATUSES=재학,휴학

# --- Admin token for POST /admin/match/run.  generate: openssl rand -hex 32 ---
ADMIN_TOKEN=<paste-a-long-random-secret>
# Weekly auto-match — enable on this single instance.
MATCH_CRON_ENABLED=true

# --- Push (FCM). One-line service-account JSON. Logs a no-op until set. ---
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account", ...}

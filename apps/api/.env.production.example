# apps/api — PRODUCTION env (EC2). Copy to apps/api/.env on the server and fill in.
# Never commit the real file.

# --- Database: AWS RDS PostgreSQL (same region: ap-northeast-2) ---
DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>.ap-northeast-2.rds.amazonaws.com:5432/hgt
DATABASE_SSL=true

# --- Server ---
PORT=8080
# The Vercel frontend origin(s), comma-separated, NO trailing slash.
CORS_ORIGINS=https://<your-app>.vercel.app

# --- Hongik 재학생 게이팅 (운영은 졸업 제외) ---
HONGIK_ALLOWED_STATUSES=재학,휴학

# --- Admin + weekly matching ---
# Generate a strong secret:  openssl rand -hex 32
ADMIN_TOKEN=<paste-a-long-random-secret>
# Enable the weekly auto-match on this (single) instance.
MATCH_CRON_ENABLED=true
